  },
  "bugs": {
    "url": "https://github.com/yourusername/hubspot-mcp-server-docker/issues"
  },
  "homepage": "https://github.com/yourusername/hubspot-mcp-server-docker#readme",
  "dependencies": {
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.56.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
